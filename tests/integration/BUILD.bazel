load("@rules_shell//shell:sh_test.bzl", "sh_test")

sh_test(
    name = "deploy_test",
    srcs = ["deploy_test.sh"],
    data = [
        "fake_ssh.sh",
        "//tests/testdata:sh_app.deploy",
        "//tests/testdata:sh_app.remote",
        "@rsync",
    ],
    env = {
        "DEPLOY": "$(rlocationpath //tests/testdata:sh_app.deploy)",
        "FAKE_SSH": "$(rlocationpath fake_ssh.sh)",
        "RSYNC": "$(rlocationpath @rsync)",
        "RUN": "$(rlocationpath //tests/testdata:sh_app.remote)",
    },
