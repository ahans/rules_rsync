load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//rsync:defs.bzl", "rsync_deploy", "rsync_run")

package(default_visibility = ["//tests:__subpackages__"])

sh_binary(
    name = "sh_app",
    srcs = ["sh_app.sh"],
    data = ["greeting.txt"],
)

rsync_deploy(
    name = "sh_app.deploy",
    target = ":sh_app",
    host = "attr-host",
)

rsync_run(
    name = "sh_app.remote",
    deploy = ":sh_app.deploy",
    remote_args = ["from attr"],
    remote_env = {"APP_ENV": "set by rsync_run"},
)

py_binary(
    name = "py_app",
    srcs = ["py_app.py"],
    data = ["greeting.txt"],
    deps = ["@rules_python//python/runfiles"],
)

rsync_deploy(
    name = "py_app.deploy",
    target = ":py_app",
)

cc_binary(
    name = "cc_app",
    srcs = ["cc_app.cc"],
    data = ["greeting.txt"],
    deps = ["@rules_cc//cc/runfiles"],
)

rsync_deploy(
    name = "cc_app.deploy",
    target = ":cc_app",
)
