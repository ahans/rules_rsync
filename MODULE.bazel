module(
    name = "rules_rsync",
    version = "0.0.0",
)

bazel_dep(name = "rsync", version = "3.5.1")
bazel_dep(name = "rules_shell", version = "0.6.1")

bazel_dep(name = "rules_cc", version = "0.2.28", dev_dependency = True)
bazel_dep(name = "rules_python", version = "2.4.6", dev_dependency = True)
bazel_dep(name = "platforms", version = "1.1.0", dev_dependency = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python", dev_dependency = True)
python.toolchain(
    is_default = True,
    python_version = "3.14",
)

uv = use_extension("@rules_python//python/uv:uv.bzl", "uv", dev_dependency = True)
uv.configure()

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip", dev_dependency = True)
pip.parse(
    experimental_index_url = "https://pypi.org/simple",
    hub_name = "rules_rsync_pypi",
    python_version = "3.14",
    requirements_lock = "//test:requirements_lock.txt",
    target_platforms = [
        "linux_x86_64",
        "linux_aarch64",
    ],
)
use_repo(pip, "rules_rsync_pypi")
