#!/usr/bin/env bash
# Generated by rules_rsync: deploys (and for rsync_run, runs) %LABEL%.
set -euo pipefail

# Values baked in at analysis time.
DEFAULT_HOST=%HOST%
DEFAULT_DEST=%DEST%
LABEL=%LABEL%
BIN_NAME=%BIN_NAME%
BIN_RLOCATION=%BIN_RLOCATION%
FILTER_RLOCATION=%FILTER_RLOCATION%
RSYNC_RLOCATION=%RSYNC_RLOCATION%
RSYNC_OPTS=(%RSYNC_OPTS%)
SSH_OPTS=(%SSH_OPTS%)
RUN=%RUN%
RUN_ARGS=(%RUN_ARGS%)
RUN_ENV=(%RUN_ENV%)

die() {
  echo "rules_rsync: $*" >&2
  exit 2
}

usage() {
  cat <<EOF
Deploys $LABEL with rsync.

Options:
  --host=[USER@]HOST  Host to deploy to; empty for a local directory.
                      Default: \$RULES_RSYNC_HOST, else '${DEFAULT_HOST}'.
  --dest=DIR          Destination directory, relative to the remote home.
                      Default: \$RULES_RSYNC_DEST, else '${DEFAULT_DEST}'.
  --ssh=COMMAND       ssh command to use. Default: \$RULES_RSYNC_SSH, else ssh
                      with connection sharing.
  --dry-run           Show what would be transferred without changing files.
  --verbose           List transferred files.
EOF
  if ((RUN)); then
    cat <<EOF
  --no-deploy         Run the previously deployed binary without syncing.

Launcher options must be followed by '--'; without '--', all arguments are
passed to the binary.
EOF
  fi
}

# Quotes a word for a POSIX shell.
sh_quote() {
  printf "'%s'" "${1//\'/\'\\\'\'}"
}

# Quotes a word for rsync's -e option, which doubles quotes instead of
# backslash-escaping them.
rsync_quote() {
  printf "'%s'" "${1//\'/\'\'}"
}

# Find the runfiles tree: next to the launcher for `bazel run`, from the
# environment when called from a test or another launcher.
if [[ -d "$0.runfiles" ]]; then
  RUNFILES="$0.runfiles"
elif [[ -n "${RUNFILES_DIR:-}" ]]; then
  RUNFILES="$RUNFILES_DIR"
elif [[ "$0" == *.runfiles/* ]]; then
  RUNFILES="${0%%.runfiles/*}.runfiles"
else
  die "cannot find runfiles of $0"
fi
RUNFILES="$(cd "$RUNFILES" && pwd)"

host="$DEFAULT_HOST"
dest="$DEFAULT_DEST"
ssh_cmd="${RULES_RSYNC_SSH:-}"
[[ -n "${RULES_RSYNC_HOST+set}" ]] && host="$RULES_RSYNC_HOST"
[[ -n "${RULES_RSYNC_DEST+set}" ]] && dest="$RULES_RSYNC_DEST"
dry_run=0
verbose=0
deploy=1

parse_options() {
  while (($#)); do
    case "$1" in
      --host=*) host="${1#*=}" ;;
      --dest=*) dest="${1#*=}" ;;
      --ssh=*) ssh_cmd="${1#*=}" ;;
      --dry-run) dry_run=1 ;;
      --verbose) verbose=1 ;;
      --no-deploy) ((RUN)) || die "--no-deploy only applies to rsync_run"; deploy=0 ;;
      --help) usage; exit 0 ;;
      *) die "unknown option '$1' (see --help)" ;;
    esac
    shift
  done
}

binary_args=()
if ((RUN)); then
  # Launcher options are only recognized before an explicit '--'.
  for ((i = 1; i <= $#; i++)); do
    if [[ "${!i}" == "--" ]]; then
      parse_options "${@:1:i-1}"
      set -- "${@:i+1}"
      break
    fi
  done
  binary_args=(${RUN_ARGS[@]+"${RUN_ARGS[@]}"} "$@")
else
  parse_options "$@"
fi

# A leading ~/ would be quoted away below; relative paths already start in $HOME.
case "$dest" in
  "~") dest="." ;;
  "~/"*) dest="${dest#"~/"}" ;;
esac
[[ -n "$dest" ]] || die "destination must not be empty"
if [[ -z "$host" && "$dest" != /* ]]; then
  dest="$HOME/$dest"
fi

if [[ -n "$ssh_cmd" ]]; then
  read -r -a ssh <<<"$ssh_cmd"
else
  # Share one connection between the rsync calls and the run.
  mkdir -p "$HOME/.ssh"
  ssh=(ssh -o ControlMaster=auto -o "ControlPath=$HOME/.ssh/rules_rsync-%C" -o ControlPersist=10m)
fi
ssh+=(${SSH_OPTS[@]+"${SSH_OPTS[@]}"})

do_deploy() {
  local rsync="$RUNFILES/$RSYNC_RLOCATION"
  local opts=(-pt --chmod=u+w)
  ((verbose || dry_run)) && opts+=(--itemize-changes)
  ((dry_run)) && opts+=(--dry-run)
  opts+=(${RSYNC_OPTS[@]+"${RSYNC_OPTS[@]}"})

  local prefix=""
  if [[ -n "$host" ]]; then
    local rsh="" word
    for word in "${ssh[@]}"; do
      rsh+="${rsh:+ }$(rsync_quote "$word")"
    done
    opts+=(-e "$rsh" --rsync-path="mkdir -p $(sh_quote "$dest") && rsync")
    prefix="$host:"
  else
    mkdir -p "$dest"
  fi

  # The runfiles tree consists of absolute symlinks into Bazel's output base,
  # which have to be copied as files. Relative symlinks within the tree (e.g.
  # the interpreter of a Python venv) are kept, since tools resolve them.
  "$rsync" "${opts[@]}" -rl --copy-unsafe-links --delete --delete-excluded \
    --exclude-from="$RUNFILES/$FILTER_RLOCATION" \
    "$RUNFILES/" "$prefix$dest/$BIN_NAME.runfiles/"
  "$rsync" "${opts[@]}" -L "$RUNFILES/$BIN_RLOCATION" "$prefix$dest/$BIN_NAME"

  if ((!dry_run)); then
    echo "rules_rsync: deployed $LABEL to ${host:+$host:}$dest" >&2
  fi
}

((deploy)) && do_deploy
((RUN)) || exit 0
((dry_run)) && exit 0

cmd="cd $(sh_quote "$dest/$BIN_NAME.runfiles/_main") && exec env"
for word in ${RUN_ENV[@]+"${RUN_ENV[@]}"}; do
  cmd+=" $(sh_quote "$word")"
done
cmd+=" ../../$(sh_quote "$BIN_NAME")"
for word in ${binary_args[@]+"${binary_args[@]}"}; do
  cmd+=" $(sh_quote "$word")"
done

if [[ -z "$host" ]]; then
  # The deployed binary must find its own runfiles, not the launcher's.
  unset RUNFILES_DIR RUNFILES_MANIFEST_FILE JAVA_RUNFILES PYTHON_RUNFILES
  exec sh -c "$cmd"
fi
tty=()
[[ -t 0 && -t 1 ]] && tty=(-t)
exec "${ssh[@]}" ${tty[@]+"${tty[@]}"} "$host" "$cmd"
